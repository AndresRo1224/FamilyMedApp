# plantilla de variables de entorno del backend (NO subir el .env real a git)
# copialo como .env y llena los valores en local

DJANGO_SECRET_KEY=cambiame-genera-uno-aleatorio
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# string de conexion a MongoDB Atlas (Connect > Drivers > Python)
# acepta MONGO_URI o MONGODB_URI
MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/familymed?retryWrites=true&w=majority

# (opcional) restringe CORS a estos origenes separados por coma
# si se deja vacio, permite todos (la API usa JWT en header, no cookies)
CORS_ALLOWED_ORIGINS=

# (opcional) crea el superuser automaticamente en el deploy si no existe
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=cambiame
DJANGO_SUPERUSER_EMAIL=
